// --- FUNGSI BARU UNTUK LOGIKA TRIAL (DIMODIFIKASI) ---
// ================================================================
/**
 * Menangani logika untuk login trial dinamis per deviceId.
 */
function handleTrialLogic(deviceId) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var trialSheet = ss.getSheetByName(TRIAL_SHEET_NAME);

    // Jika sheet "TrialUsers" tidak ada, buat secara otomatis
    if (!trialSheet) {
      trialSheet = ss.insertSheet(TRIAL_SHEET_NAME);
      // --- PERUBAHAN: Header baru (Kolom A, B, C, D, E) ---
      trialSheet.getRange("A1:E1").setValues([
        ["DeviceId", "LoginCount (Terpakai)", "MaxTrialLimit (Batas)", 2, "<- Default Trial (untuk user baru)"]
      ]); 
      trialSheet.getRange("A1:C1, E1").setFontWeight("bold");
      trialSheet.getRange("D1").setFontWeight("bold").setFontColor("#ff0000"); // Beri warna merah pada angka
      Logger.log("Sheet " + TRIAL_SHEET_NAME + " berhasil dibuat.");
    }

    var data = trialSheet.getDataRange().getValues();
    
    // --- PERUBAHAN: Baca batas trial default dari header (Sel D1) ---
    var defaultTrialLimit = 2; // Default fallback
    if (data.length > 0 && data[0][3] && !isNaN(parseInt(data[0][3], 10))) {
      // data[0][3] adalah baris pertama (indeks 0), kolom keempat (indeks 3) = Sel D1
      defaultTrialLimit = parseInt(data[0][3], 10);
    }
    // --- AKHIR PERUBAHAN ---

    var userRow = -1; // Index baris user (1-based)
    var loginCount = 0;
    var maxLimitForThisUser = 0; // Batas trial khusus untuk device ini

    // 1. Cari deviceId di sheet TrialUsers (mulai dari baris 1 untuk skip header)
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] == deviceId) { // Kolom A: DeviceId
        userRow = i + 1; // (i adalah 0-based, +1 jadi 1-based untuk getRange)
        loginCount = parseInt(data[i][1], 10) || 0; // Kolom B: LoginCount (Terpakai)
        maxLimitForThisUser = parseInt(data[i][2], 10) || 0; // Kolom C: MaxTrialLimit (Batas)
        break;
      }
    }

    var result = {};

    if (userRow === -1) {
      // --- KASUS 1: USER TRIAL BARU (Login ke-1) ---
      var newLoginCount = 1;
      maxLimitForThisUser = defaultTrialLimit; // Gunakan default dari D1
      
      // Tulis baris baru: [deviceId, 1, (angka default dari D1)]
      trialSheet.appendRow([deviceId, newLoginCount, maxLimitForThisUser]); 
      
      var sisaTrial = maxLimitForThisUser - newLoginCount;
      sisaTrial = Math.max(0, sisaTrial); // Pastikan tidak negatif
      
      result = {
        status: "success",
        message: "Trial berhasil. Sisa " + sisaTrial + "x login.",
        expiryDate: "Trial", 
        remainingLogins: sisaTrial
      };
      sendTelegramNotification("🚀 TRIAL LOGIN (Baru)\n<b>Perangkat:</b> " + deviceId + "\n<b>Sisa Trial:</b> " + sisaTrial + "x (dari " + maxLimitForThisUser + ")");

    } else if (loginCount < maxLimitForThisUser) {
      // --- KASUS 2: USER TRIAL LAMA (Masih ada jatah) ---
      // 'maxLimitForThisUser' dibaca dari Kolom C baris ini
      var newLoginCount = loginCount + 1;
      trialSheet.getRange(userRow, 2).setValue(newLoginCount); // Update Kolom B
      
      var sisaTrial = maxLimitForThisUser - newLoginCount;
      var pesan = (sisaTrial === 0) ? "Trial terakhir Anda berhasil." : "Trial berhasil. Sisa " + sisaTrial + "x login.";
      
      result = {
        status: "success",
        message: pesan,
        expiryDate: "Trial",
        remainingLogins: sisaTrial
      };
      sendTelegramNotification("🚀 TRIAL LOGIN (Ulang)\n<b>Perangkat:</b> " + deviceId + "\n<b>Sisa Trial:</b> " + sisaTrial + "x (dari " + maxLimitForThisUser + ")");

    } else {
      // --- KASUS 3: JATAH TRIAL HABIS (loginCount >= maxLimitForThisUser) ---
      result = {
        status: "error",
        message: "Masa trial Anda telah habis. Silakan beli token."
      };
      sendTelegramNotification("❌ TRIAL GAGAL\n<b>Perangkat:</b> " + deviceId + "\n<b>Alasan:</b> Jatah trial habis (" + loginCount + "/" + maxLimitForThisUser + "x).");
    }

    // Kembalikan hasil trial
    return ContentService.createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (e) {
    // Tangkap error spesifik untuk trial
    var errorResult = { status: "error", message: "Terjadi error pada server trial: " + e.message };
    sendTelegramNotification("❌ ERROR PADA FUNGSI TRIAL:\n" + e.message);
    return ContentService.createTextOutput(JSON.stringify(errorResult))
      .setMimeType(ContentService.MimeType.JSON);
  }
}


/**
 * Fungsi utama yang menangani permintaan
 * (Tidak ada perubahan di sini, hanya memanggil fungsi di atas)
 */
function doGet(e) {
  // 1. Ambil parameter
  var token = e.parameter.token;
  var deviceId = e.parameter.deviceId; 

  // ================================================================
  // --- INTERSEP PERMINTAAN TRIAL ---
  // ================================================================
  if (token === "TRIAL_REQUEST") {
    if (!deviceId) {
       var errorResult = { status: "error", message: "DeviceId tidak ditemukan untuk trial." };
       return ContentService.createTextOutput(JSON.stringify(errorResult))
         .setMimeType(ContentService.MimeType.JSON);
    }
    return handleTrialLogic(deviceId);
  }
  // ================================================================
  // --- AKHIR BLOK TRIAL ---
  // ================================================================

  // Jika token BUKAN "TRIAL_REQUEST", jalankan logika token normal Anda
  
  // 2. Akses Spreadsheet
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
  var dataRange = sheet.getRange(1, 1, sheet.getLastRow(), 5); 
  var values = dataRange.getValues();

  // 3. Siapkan variabel hasil
  var result = {
    status: "error",
    message: "Token tidak ditemukan"
  };

  var today = new Date();
  today.setHours(0, 0, 0, 0); 
  var tokenFound = false;

  // 4. Loop untuk memeriksa token, tanggal, dan deviceId
  for (var i = 0; i < values.length; i++) {
    var sheetToken = values[i][0];     // Kolom A
    var expiryDate = new Date(values[i][1]); // Kolom B
    var storedDeviceId = values[i][2]; // Kolom C
    var loginLimit = values[i][3]; // Kolom D (Batas Maks)
    var loginCount = values[i][4]; // Kolom E (Jumlah Terpakai)

    expiryDate.setHours(0, 0, 0, 0);

    if (sheetToken == token) {
      tokenFound = true;
      var remainingDays = Math.ceil((expiryDate - today) / (1000 * 60 * 60 * 24));
      
      if (expiryDate < today) {
        // Kasus 1: Token ditemukan TAPI kedaluwarsa
        result.status = "error";
        result.message = "Token telah kedaluwarsa";
      
      } else if (typeof loginLimit === 'number' && loginLimit > 0 && typeof loginCount === 'number' && loginCount >= loginLimit) {
        // Kasus 1b: Token valid, TAPI batas login habis
        result.status = "error";
        result.message = "Token telah mencapai batas penggunaan login.";
        sendTelegramNotification("❌ LOGIN GAGAL\n<b>Token:</b> " + token + "\n<b>Alasan:</b> Batas penggunaan login ("+loginLimit+") telah habis.");

      } else if (storedDeviceId == "") {
        // Kasus 2: Token valid, belum kedaluwarsa, BELUM DIKLAIM, dan batas login OK
        
        var newLoginCount = (typeof loginCount === 'number' ? loginCount : 0) + 1;
        sheet.getRange(i + 1, 5).setValue(newLoginCount); 
        sheet.getRange(i + 1, 3).setValue(deviceId); 
        
        result.status = "success";
        result.message = "Token diterima dan berhasil dikunci ke perangkat ini.";
        
        var formattedExpiry = Utilities.formatDate(expiryDate, "GMT+7", "dd MMMM yyyy");
        result.expiryDate = formattedExpiry;
        result.remainingLogins = (typeof loginLimit === 'number' && loginLimit > 0) ? (loginLimit - newLoginCount) : "Unlimited"; 

        sendTelegramNotification("✅ LOGIN BERHASIL (Klaim Baru)\n<b>Token:</b> " + token + "\n<b>Perangkat:</b> " + deviceId + "\n<b>Expired:</b> " + formattedExpiry + "\n<b>Sisa Login:</b> " + result.remainingLogins);

      } else if (storedDeviceId == deviceId) {
        // Kasus 3: Token valid, DAN deviceId cocok
        
        var newLoginCount = (typeof loginCount === 'number' ? loginCount : 0) + 1;
        sheet.getRange(i + 1, 5).setValue(newLoginCount); 

        result.status = "success";
        result.message = "Token diterima";
        
        var formattedExpiry = Utilities.formatDate(expiryDate, "GMT+7", "dd MMMM yyyy");
        result.expiryDate = formattedExpiry;
        result.remainingLogins = (typeof loginLimit === 'number' && loginLimit > 0) ? (loginLimit - newLoginCount) : "Unlimited";

        sendTelegramNotification("✅ LOGIN BERHASIL (Ulang)\n<b>Token:</b> " + token + "\n<b>Expired:</b> " + formattedExpiry + "\n<b>Sisa Login:</b> " + result.remainingLogins);

      } else {
        // Kasus 4: Token valid, TAPI deviceId TIDAK COCOK
        result.status = "error";
        result.message = "Token ini telah terkunci di perangkat lain.";
        sendTelegramNotification("❌ LOGIN GAGAL\n<b>Token:</b> " + token + "\n<b>Alasan:</b> Mencoba login dari perangkat baru (tidak cocok).");
      }

      break; // Hentikan loop
    }
  }

  // Jika token tidak ditemukan sama sekali
  if (!tokenFound && token) { 
    sendTelegramNotification("❌ LOGIN GAGAL\n<b>Token:</b> " + token + "\n<b>Alasan:</b> Token tidak ditemukan.");
  }

  // 5. Kembalikan hasil sebagai JSON
  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}


